# Copy this database setting into .env.local; match your Compose credentials.
DATABASE_URL="postgresql://leave_app:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/leave_and_claim"
# Sign-in password (12-128 characters) that npm run db:seed gives the local demo accounts.
SEED_PASSWORD="REPLACE_WITH_LOCAL_DEMO_PASSWORD"
# Email sender for npm run notifications:deliver; "log" prints emails (development only).
EMAIL_DRIVER="log"
# Link included in emails.
APP_URL="http://localhost:3000"
# If compose.yaml references POSTGRES_PASSWORD, configure it in the ignored .env file.
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
