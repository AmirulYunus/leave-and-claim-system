{
  "name": "leave_and_claim_system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "format": "prettier --write app scripts tests prisma/seed.ts prisma.config.ts",
    "format:check": "prettier --check app scripts tests prisma/seed.ts prisma.config.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "notifications:deliver": "tsx scripts/notifications.ts deliver",
    "notifications:remind": "tsx scripts/notifications.ts remind"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
