generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model claims {
  request_id Int      @id
  amount     Decimal  @db.Decimal(12, 2)
  requests   requests @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model departments {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  is_active Boolean     @default(true)
  employees employees[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cost_centres {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  is_active Boolean     @default(true)
  employees employees[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employees {
  id                     Int                 @id @default(autoincrement())
  name                   String
  email                  String              @unique
  join_date              DateTime            @db.Date
  /// Employee, HR, or Admin; enforced by a PostgreSQL CHECK constraint.
  role                   String
  position               String?
  /// Full-time, Part-time, or Intern; null until HR supplies it.
  employment_type        String?
  /// 1-4; null until HR supplies it.
  employee_level         Int?                @db.SmallInt
  probation_completed_on DateTime?           @db.Date
  leaving_date           DateTime?           @db.Date
  is_active              Boolean             @default(true)
  department_id          Int?
  cost_centre_id         Int?
  password_hash          String?
  must_change_password   Boolean             @default(true)
  sessions               sessions[]
  department             departments?        @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cost_centre            cost_centres?       @relation(fields: [cost_centre_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submittedRequests      requests[]          @relation("requests_employee_idToemployees")
  reviewedRequests       requests[]          @relation("requests_reviewed_byToemployees")
  timesheet_entries      timesheet_entries[]
}

model sessions {
  /// SHA-256 digest of the token held in the session cookie.
  token_hash  String    @id
  employee_id Int
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6)
  employee    employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "sessions_employee")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leave_entries {
  request_id Int
  date       DateTime @db.Date
  hours      Decimal  @db.Decimal
  requests   requests @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([request_id, date])
  @@index([date], map: "leave_entries_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model requests {
  id            Int             @id @default(autoincrement())
  employee_id   Int
  kind          String
  category      String
  detail        String
  note          String
  status        String          @default("Pending")
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  reviewed_by   Int?
  reviewed_at   DateTime?       @db.Timestamptz(6)
  claims        claims?
  leave_entries leave_entries[]
  employee      employees       @relation("requests_employee_idToemployees", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer      employees?      @relation("requests_reviewed_byToemployees", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employee_id, status], map: "requests_employee_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model timesheet_entries {
  employee_id Int
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([employee_id, date])
}
